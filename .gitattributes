# Normalise line endings in the repository to LF, whatever the checkout does
# locally. Without this the blobs held CRLF while tooling wrote LF, so every
# generated edit showed as a whole-file rewrite — 2832 changed lines across
# four files with byte-identical content.
* text=auto

# Explicit for the source we actually edit.
*.html  text eol=lf
*.css   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.svg   text eol=lf
*.xml   text eol=lf
*.txt   text eol=lf
*.md    text eol=lf

# Never touched.
*.webp  binary
*.jpg   binary
*.jpeg  binary
*.png   binary
*.avif  binary
*.ico   binary
*.mp4   binary
*.woff  binary
*.woff2 binary
